# Lista de permissao: ignore tudo por padrao.
*

# Arquivos de controle do repositorio.
!/.gitignore
!/README.md

# Somente os materiais do curso podem ser versionados.
!/Experts/
!/Experts/PQ/
!/Experts/PQ/**
!/Scripts/
!/Scripts/PQ/
!/Scripts/PQ/**
!/Indicators/
!/Indicators/PQ/
!/Indicators/PQ/**
!/Include/
!/Include/PQ/
!/Include/PQ/**

# Nunca versionar artefatos compilados ou temporarios, inclusive dentro do curso.
**/*.ex5
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.cache
**/~*
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db
